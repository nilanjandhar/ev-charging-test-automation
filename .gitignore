playwright/.cache/
test-results/
*.webm
trace.zip

# ---------------------------------------------------------------------------
# Databases created by running the service or the suite
# ---------------------------------------------------------------------------
# The service builds its engine from DATABASE_URL at import time and defaults to
# a file relative to the working directory, so a stray .db can appear at the repo
# root, in service/, or wherever a command was run from.
*.db
*.db-journal
*.db-wal
*.db-shm
*.sqlite
*.sqlite3
noc.db
service/*.db

